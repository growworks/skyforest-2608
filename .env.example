# ─────────────────────────────────────────────
# 상담신청 API (GrowWorks Public API)
# 엔드포인트 = ${API_BASE_URL}/v1/${SITE_SLUG}/contact
# slug 는 어드민에 등록된 skyforest (도메인 skyforestclean.com 과 다름)
# ─────────────────────────────────────────────
SITE_SLUG=skyforest
API_BASE_URL=https://api.growworks.co.kr

# true 면 외부 호출 없이 콘솔 로그 + 성공 응답 (실 접수 원치 않는 로컬 작업용)
CONTACT_API_MOCK=false

# ─────────────────────────────────────────────
# SEO / 분석 (선택)
# 미설정 시 https://skyforestclean.com 이 기본값
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://skyforestclean.com
